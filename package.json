{
  "name": "@museumwnf/viewer-i18n",
  "version": "3.1.1",
  "description": "Shared static texts for the MWNF website platform: the core, layout, catalogue, sheet, record, gallery, exhibition, timeline and partner namespaces.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metanull/viewer-i18n.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "namespaces.json",
    "tools/check.mjs"
  ],
  "exports": {
    "./standalone": "./dist/standalone/index.js",
    "./gallery": "./dist/gallery/index.js",
    "./exhibition": "./dist/exhibition/index.js",
    "./namespaces.json": "./namespaces.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "viewer-i18n-check": "tools/check.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs --dictionary .",
    "test": "node --test \"tools/*.test.mjs\" && npm run check && npm run build"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.42"
  }
}
